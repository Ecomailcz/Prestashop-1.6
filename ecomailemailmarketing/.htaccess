# Apache 2.2
<IfModule !mod_authz_core.c>
    <FilesMatch "\.php$">
        Order allow,deny
        Deny from all
    </FilesMatch>
    <Files "webhook.php">
        Order allow,deny
        Allow from all
    </Files>
</IfModule>

# Apache 2.4
<IfModule mod_authz_core.c>
    <FilesMatch "\.php$">
        Require all denied
    </FilesMatch>
    <Files "webhook.php">
        Require all granted
    </Files>
</IfModule>
